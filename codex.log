    124 +function buildJobSearchText(job) {
    125 +  return `${job.title} ${job.company} ${job.location} ${(job.tags || []).join(" ")}`.toLowerCase();
    126 +}
    127 +
    128 +function scoreJob(job, keyword) {
    129 +  const terms = keyword.split(/\s+/).filter(Boolean);
    130 +  if (!terms.length) return 1;
    131 +  let total = 0;
    132 +  for (const term of terms) {
    133 +    const titleScore = fuzzyRatio(job.title.toLowerCase(), term) * 1.15;
    134 +    const companyScore = fuzzyRatio(job.company.toLowerCase(), term) * 0.9;
    135 +    const locationScore = fuzzyRatio(job.location.toLowerCase(), term) * 0.75;
    136 +    const tagScore =
    137 +      (job.tags || []).reduce(
    138 +        (acc, tag) => Math.max(acc, fuzzyRatio(tag.toLowerCase(), term)),
    139 +        0,
    140 +      ) * 0.9;
    141 +    const lineScore = subsequenceScore(job.searchText, term);
    142 +    const best = Math.max(titleScore, companyScore, tagScore, locationScore, lineScore);
    143 +    total += best;
    144 +  }
    145 +  const avg = total / terms.length;
    146 +  const densityBoost = job.searchText.includes(keyword) ? 0.35 : 0;
    147 +  return Math.min(1.5, avg + densityBoost);
    148 +}
    149 +
    150 +function fuzzyRatio(a, b) {
    151 +  if (!a || !b) return 0;
    152 +  const dist = levenshtein(a, b);
    153 +  const maxLen = Math.max(a.length, b.length);
    154 +  if (maxLen === 0) return 1;
    155 +  return Math.max(0, 1 - dist / maxLen);
    156 +}
    157 +
    158 +function subsequenceScore(text, query) {
    159 +  let ti = 0;
    160 +  let score = 0;
    161 +  let streak = 0;
    162 +  for (const ch of query) {
    163 +    const idx = text.indexOf(ch, ti);
    164 +    if (idx === -1) break;
    165 +    const adjacency = idx === ti ? 1 : Math.max(0, 1 - (idx - ti) * 0.15);
    166 +    const anchor = idx === 0 || text[idx - 1] === " " ? 0.4 : 0;
    167 +    streak = idx === ti ? streak + 1 : 0;
    168 +    score += 0.6 + adjacency + anchor + streak * 0.1;
    169 +    ti = idx + 1;
    170 +  }
    171 +  return score / Math.max(query.length, 1);
    172 +}
    173 +
    174 +function levenshtein(a, b) {
    175 +  if (a === b) return 0;
    176 +  const rows = a.length + 1;
    177 +  const cols = b.length + 1;
    178 +  const dp = Array.from({ length: rows }, (_, i) => {
    179 +    const row = new Array(cols).fill(0);
    180 +    row[0] = i;
    181 +    return row;
    182 +  });
    183 +  for (let j = 1; j < cols; j += 1) dp[0][j] = j;
    184 +  for (let i = 1; i < rows; i += 1) {
    185 +    for (let j = 1; j < cols; j += 1) {
    186 +      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
    187 +      dp[i][j] = Math.min(
    188 +        dp[i - 1][j] + 1,
    189 +        dp[i][j - 1] + 1,
    190 +        dp[i - 1][j - 1] + cost,
    191 +      );
    192 +    }
    193 +  }
    194 +  return dp[rows - 1][cols - 1];
    195 +}
