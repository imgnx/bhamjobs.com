# Auth
# Used for private routes (chat, payments) and admin verification (/api/admin/verify)
API_TOKEN=change-me-very-secret
NEXT_PUBLIC_API_TOKEN=change-me-very-secret

# PostgreSQL (choose either DATABASE_URL or discrete params)
DATABASE_URL=postgres://admin:secret@127.0.0.1:5432/bhamjobs
PGHOST=127.0.0.1
PGUSER=admin
PGPASSWORD=secret
PGDATABASE=bhamjobs
PGPORT=5432

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ASR (faster-whisper)
# Path to python (or leave default)
ASR_PYTHON=python3
# Model name or local path. Examples: tiny, base, small, medium, large-v2
ASR_MODEL=base
# Compute type: int8 (default), int8_float16, float16, float32
ASR_COMPUTE_TYPE=int8
# Optional: max upload size and output length
# ASR_MAX_UPLOAD_BYTES=8388608
# ASR_MAX_TEXT_LEN=1200
# ASR_TIMEOUT_MS=120000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_TEST_PRICE_ID=
