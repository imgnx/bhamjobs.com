{
  "name": "bhamjobs.com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare:env": "cp -n .env.example .env 2>/dev/null || cp .env.example .env",
    "sxetup": "pnpm prepare:env && pnpm db:init",
    "up": "pnpm setup && pnpm dev",
    "db:init": "psql \"$DATABASE_URL\" -f sql/init.sql || psql -h $PGHOST -U $PGUSER -d $PGDATABASE -f sql/init.sql",
    "db:migrate:lisp": "sbcl --script scripts/migrate.lisp",
    "db:migrate": "pnpm db:migrate:lisp",
    "lint": "echo 'no linter configured'",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "next": "^14.2.12",
    "openai": "^4.56.0",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-jsx": "^5.1.7",
    "stripe": "^19.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tailwindcss": "^4.0.0"
  },
