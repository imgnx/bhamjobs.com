{
  "name": "bhamjobs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint src",
    "prepare:env": "cp -n .env.example .env 2>/dev/null || cp .env.example .env",
    "db:docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:docker:down": "docker compose -f docker-compose.dev.yml down",
    "db:docker:logs": "docker compose -f docker-compose.dev.yml logs -f db",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:init": "psql \"$DATABASE_URL\" -f sql/init.sql || psql -h $PGHOST -U $PGUSER -d $PGDATABASE -f sql/init.sql",
    "db:migrate:lisp": "sbcl --script scripts/migrate.lisp",
    "db:migrate": "prisma migrate dev",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "next": "^16.1.0",
    "openai": "^4.56.0",
    "pg": "^8.12.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "stripe": "^19.1.0",
    "styled-jsx": "^5.1.7",
    "vite": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "prisma": "^5.20.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
